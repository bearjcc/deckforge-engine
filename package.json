{
  "name": "deckforge-engine",
  "version": "1.0.0",
  "description": "Generic deck-building adventure game engine - bring your own content!",
  "main": "public/index.html",
  "type": "module",
  "scripts": {
    "start": "npx serve public -p 3000",
    "test": "node tests/engine.test.js && node tests/integration.test.js",
    "test:unit": "node tests/engine.test.js",
    "test:integration": "node tests/integration.test.js",
    "test:watch": "node --watch tests/engine.test.js",
    "validate": "node tests/validate-content.js",
    "test:all": "npm run validate && npm test"
  },
  "keywords": [
    "deck-building",
    "card-game",
    "game-engine",
    "browser-game",
    "roguelike",
    "adventure-game",
    "open-source",
    "javascript",
    "es6-modules"
  ],
  "author": {
    "name": "Joseph C. Caswell",
    "email": "bearjcc@gmail.com",
    "url": "https://ursaminor.games"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bearjcc/deckforge-engine.git"
  },
  "bugs": {
    "url": "https://github.com/bearjcc/deckforge-engine/issues"
  },
  "homepage": "https://github.com/bearjcc/deckforge-engine#readme",
  "engines": {
    "node": ">=14.0.0"
  }
}



