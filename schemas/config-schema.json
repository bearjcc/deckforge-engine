{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deckforge.games/schemas/config.json",
  "title": "Game Configuration",
  "description": "Main configuration for a DeckForge game",
  "type": "object",
  "required": ["gameName", "version"],
  "properties": {
    "gameName": {
      "type": "string",
      "description": "Name of your game",
      "minLength": 1,
      "examples": ["My Awesome Game", "Space Adventure", "Fantasy Quest"]
    },
    "version": {
      "type": "string",
      "description": "Game content version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["1.0.0", "2.1.3"]
    },
    "description": {
      "type": "string",
      "description": "Short description of your game",
      "examples": ["A space-themed deck-building adventure"]
    },
    "startingEnergy": {
      "type": "integer",
      "description": "Energy player starts with each turn",
      "minimum": 0,
      "default": 3,
      "examples": [3, 5, 0]
    },
    "startingHealth": {
      "type": "integer",
      "description": "Player's starting and maximum HP",
      "minimum": 1,
      "default": 50,
      "examples": [50, 72, 100]
    },
    "currencies": {
      "type": "array",
      "description": "Game-specific currencies/resources",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "examples": ["gold", "mana", "funding"]
          },
          "name": {
            "type": "string",
            "examples": ["Gold", "Mana", "Science Points"]
          },
          "icon": {
            "type": "string",
            "examples": ["💰", "⚗️", "🔬"]
          },
          "startingAmount": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        }
      },
      "examples": [
        [{"id": "gold", "name": "Gold", "startingAmount": 0}],
        [
          {"id": "funding", "name": "Funding", "icon": "💰"},
          {"id": "science", "name": "Science", "icon": "🔬"}
        ]
      ]
    },
    "rules": {
      "type": "object",
      "description": "Game rule variations",
      "properties": {
        "reshuffleOnEmpty": {
          "type": "boolean",
          "description": "Shuffle discard into draw when empty",
          "default": true
        },
        "blockResetsEachTurn": {
          "type": "boolean",
          "description": "Block returns to 0 at turn start",
          "default": true
        },
        "energyResetsEachTurn": {
          "type": "boolean",
          "description": "Energy returns to max at turn start",
          "default": true
        },
        "powersDurationDecreaseWhen": {
          "type": "string",
          "enum": ["turn_start", "turn_end"],
          "default": "turn_end"
        }
      }
    }
  }
}

